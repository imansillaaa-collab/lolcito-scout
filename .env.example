# Copiá este archivo como .env y completá tu key
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Opcional: tu Riot ID para ver tu pool de campeones en el reporte
MY_RIOT_ID=TuNombre#LAS

# Servidor y rango (LAS = la2; Platino y Esmeralda)
PLATFORM=la2
REGION=americas
TIERS=PLATINUM,EMERALD
ROLES=BOTTOM,UTILITY

# Cuánto escautear por día (con key de desarrollo: ~10-15 min)
PLAYERS_PER_RUN=80
MATCHES_PER_PLAYER=10
MAX_NEW_MATCHES=500
DAYS_BACK=3
MIN_GAMES=20
